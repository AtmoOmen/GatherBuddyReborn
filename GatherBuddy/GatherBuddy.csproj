<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GatherBuddy</RootNamespace>
    <AssemblyName>GatherBuddyReborn</AssemblyName>
    <Version>7.5.0.5</Version>
    <Company>SoftOtter</Company>
    <Product>GatherBuddy</Product>
    <Copyright>Copyright © 2026</Copyright>
    <Deterministic>true</Deterministic>
    <OutputType>Library</OutputType>
    <WarningLevel>4</WarningLevel>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockfileAssemblies>true</CopyLocalLockfileAssemblies>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
    <Name>GatherBuddy Reborn</Name>
    <Author>The Combat Reborn Team</Author>
    <Description>添加多种命令, 可按物品名称查找采集点、鱼类及其位置, 并提供界面追踪特殊刷新时间与天气条件, 还可基于指定清单和条件自动采集物品, 自动采集需要 vnavmesh</Description>
    <Punchline>极致简化采集与钓鱼</Punchline>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
	</PropertyGroup>

  <Target Name="EnsureCnRebornMaterialSource" BeforeTargets="PrepareForBuild;CollectPackageReferences">
    <Error Condition="!Exists('..\build-configuration\vendor\RebornMaterial\RebornMaterial\RebornMaterial.csproj')"
           Text="Run scripts/Initialize-CnRebornMaterial.ps1 before restoring or building GatherBuddyReborn." />
  </Target>

  <ItemGroup>
    <Compile Remove="AutoGather\GatheringTracker.cs" />
    <Compile Remove="Plugin\AutoGather.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="CustomInfo\IlvConvertTable.csv" />
    <None Remove="CustomInfo\mob_drop_overrides.json" />
    <None Remove="CustomInfo\world_locations.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="CustomInfo\world_locations.json" />
    <EmbeddedResource Include="CustomInfo\mob_drop_overrides.json" />
    <None Remove="CustomInfo\node_offsets.json" />
    <EmbeddedResource Include="CustomInfo\node_offsets.json" />
    <None Remove="CustomInfo\honk-sound.wav" />
    <EmbeddedResource Include="CustomInfo\honk-sound.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSCore" Version="1.2.1.2" NoWarn="NU1701" />
    <PackageReference Include="Dalamud.NET.Sdk" Version="15.0.0" />
    <PackageReference Include="LuminaSupplemental.Excel" Version="7.0.1" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\GatherBuddy.GameData\GatherBuddy.GameData.csproj" />
	  <ProjectReference Include="..\GatherBuddy.Models\GatherBuddy.Models.csproj" />
	  <ProjectReference Include="..\build-configuration\vendor\RebornMaterial\RebornMaterial\RebornMaterial.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="AutoGather\Tasks\" />
	  <Folder Include="RebornUI\" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="CustomInfo\IlvConvertTable.csv" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="CustomInfo\fish_records.json" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\build-configuration\RebornMaterial.zh-CN.patch" Link="RebornMaterial.zh-CN.patch" CopyToOutputDirectory="PreserveNewest" />
	  <EmbeddedResource Include="RebornUI\Images\*.png">
	    <LogicalName>GatherBuddy.RebornUI.Images.%(Filename)%(Extension)</LogicalName>
	  </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
	</ItemGroup>


</Project>
